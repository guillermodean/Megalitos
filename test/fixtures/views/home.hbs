<h1>home</h1><p id="total">{{fmtNum stats.total}}</p><p id="coords">{{stats.conCoordenadas}}</p><p id="imgs">{{stats.totalImagenes}}</p>
{{#each stats.tipologias}}<i class="tip">{{slug}}:{{count}}</i>{{/each}}
{{#each destacados}}<a class="card" href="/megalitos/{{id}}">{{nombre}}|{{thumb}}</a>{{/each}}
