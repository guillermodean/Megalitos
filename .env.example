# Copy to .env (never commit it). Generate strong passwords with: openssl rand -base64 32
MARIADB_ROOT_PASSWORD=change-me
MARIADB_DATABASE=megalitos
MYSQL_APP_USER=megalitos_app
MYSQL_APP_PASSWORD=change-me

# App (DB_USER = the read-only app user above; DB_PASSWORD = MYSQL_APP_PASSWORD)
DB_HOST=megalitos-db
DB_PORT=3306
DB_NAME=megalitos
DB_USER=megalitos_app
DB_PASSWORD=change-me
# PORT=8000
# IMAGES_DIR=/data/anexos
# THUMBS_DIR=/data/thumbs
# TRUST_PROXY=1            # set behind cloudflared (compose.yml already does)
# RATE_LIMIT_MAX=300       # requests per 5 min per IP
