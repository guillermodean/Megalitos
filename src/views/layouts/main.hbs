<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{title}}</title>
  <meta name="description" content="{{description}}">
  <meta name="theme-color" content="#f1ece0" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#15130f" media="(prefers-color-scheme: dark)">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Megalitos Navarra">
  <meta property="og:locale" content="es_ES">
  <meta property="og:title" content="{{title}}">
  <meta property="og:description" content="{{description}}">
  <link rel="icon" href="/favicon.svg?v={{@root.assetV}}" type="image/svg+xml">
  <link rel="preload" href="/fonts/source-serif-4-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/site.css?v={{@root.assetV}}">
  <script src="/js/site.js?v={{@root.assetV}}" defer></script>
</head>
<body class="page-{{active}}">
  <a class="skip" href="#contenido">Saltar al contenido</a>

  <header class="masthead">
    <div class="wrap masthead__in">
      <a class="brand" href="/">
        <svg class="brand__glyph" viewBox="0 0 32 32" width="26" height="26" aria-hidden="true" focusable="false">
          <path d="M3 27h26M6 27V15M26 27V15M4 12.5l24-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"/>
          <path d="M9 27v-7h14v7" fill="none" stroke="currentColor" stroke-width="1" opacity=".5"/>
        </svg>
        <span class="brand__txt">Megalitos<br>de Navarra</span>
      </a>
      <nav class="nav" aria-label="Principal">
        <a href="/megalitos"{{#if (eq active "list")}} aria-current="page"{{/if}}><span class="nav__n">01</span> Catálogo</a>
        <a href="/mapa"{{#if (eq active "mapa")}} aria-current="page"{{/if}}><span class="nav__n">02</span> Mapa</a>
        <a href="/rutas"{{#if (eq active "rutas")}} aria-current="page"{{/if}}><span class="nav__n">03</span> Rutas</a>
        <a href="/miguel-ezkurdia"{{#if (eq active "ezkurdia")}} aria-current="page"{{/if}}><span class="nav__n">04</span> Miguel Ezkurdia</a>
      </nav>
    </div>
  </header>

  <main id="contenido" tabindex="-1">
    {{{body}}}
  </main>

  <footer class="foot">
    <div class="wrap foot__grid">
      <div class="foot__org">
        <p class="label">SCN Gorosti</p>
        <p>Sociedad de Ciencias Naturales Gorosti Natur Zientzi Elkartea</p>
        <p class="foot__addr">Calderería 34, bajo, 31001 Pamplona, Navarra · 94822670</p>
      </div>
      <div>
        <p class="label">Redes</p>
        <ul class="plain">
          <li><a href="https://www.facebook.com/SCN-Gorosti-Gorosti-NZE-164619546985080/?ref=hl" rel="noopener">Facebook</a></li>
          <li><a href="https://twitter.com/SCNGorosti" rel="noopener">Twitter</a></li>
          <li><a href="https://www.youtube.com/user/SCNGorosti?feature=mhee" rel="noopener">YouTube</a></li>
        </ul>
      </div>
      <div>
        <p class="label">Enlaces</p>
        <ul class="plain">
          <li><a href="https://sites.google.com/site/scngorosti/" rel="noopener">Gorosti</a></li>
          <li><a href="http://www.guiavisual-gorosti.org/galeria/" rel="noopener">Guía visual</a></li>
          <li><a href="http://guiavisual-gorosti.org/foro/" rel="noopener">Foros</a></li>
          <li><a href="http://www.guiavisual-gorosti.org/cgi-bin/bd_gorosti.cgi" rel="noopener">Observaciones y mapas</a></li>
        </ul>
      </div>
      <dl class="titleblock" aria-label="Datos del proyecto">
        <div><dt>Proyecto</dt><dd>Megalitos Navarra</dd></div>
        <div><dt>Datos</dt><dd>Legado de Miguel Ezkurdia</dd></div>
        <div><dt>Edita</dt><dd>SCN Gorosti</dd></div>
        <div><dt>Año</dt><dd>{{year}}</dd></div>
      </dl>
    </div>
    <p class="wrap foot__credit">Plataforma web creada por Guillermo Deán · Datos: legado de Miguel Ezkurdia, depositado en la Sociedad Gorosti · © {{year}} SCN Gorosti</p>
  </footer>
</body>
</html>
