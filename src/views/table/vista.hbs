{{#each card}}
<div class="container py-5">
    <h1 class="text-center mb-5 display-4 fw-bold text-primary">{{Nombre}}</h1>
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card h-100 shadow-sm">
                <div class="card-header">Descripción</div>
                <div class="card-body">
                    <p class="card-text">{{Descripcion}}</p>
                </div>
            </div>
        </div>
        
        <div class="col-lg-4">
            <div class="card mb-4 shadow-sm">
                <div class="card-header">Información General</div>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <strong>Tipo:</strong>
                        <span>{{Des_clas}}</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <strong>Municipio:</strong>
                        <span>{{Municipio}}</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <strong>Ubicación:</strong>
                        <span>{{Ubicacion}}</span>
                    </li>
                </ul>
            </div>

             <div class="card mb-4 shadow-sm">
                <div class="card-header">Localización</div>
                <ul class="list-group list-group-flush">
                     <li class="list-group-item d-flex justify-content-between align-items-center">
                        <strong>Autor:</strong>
                        <span>{{Localizado_autor}}</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <strong>Fecha:</strong>
                        <span>{{Localizado_fecha}}</span>
                    </li>
                </ul>
            </div>
        </div>

        <div class="col-lg-8">
             <div class="card shadow-sm mb-4">
                <div class="card-header">Observaciones</div>
                <div class="card-body">
                    <p class="card-text">{{Observaciones}}</p>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
             <div class="card shadow-sm text-center">
                <div class="card-header">Coordenadas UTM</div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col"><strong>X:</strong> {{UTM_X}}</div>
                        <div class="col"><strong>Y:</strong> {{UTM_Y}}</div>
                    </div>
                    <p><strong>Altura:</strong> {{UTM_Z}} metros</p>
                    <a href="https://www.google.es/maps/search/{{Coordenadas}}" class="btn btn-primary w-100" target="_blank">
                        <i class="fas fa-map-marker-alt me-2"></i>Ver en Google Maps
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header">Galería de Imágenes</div>
                <div class="card-body p-0">
                    <div id="carouselMegalito" class="carousel slide" data-bs-ride="carousel">
                        <div class="carousel-inner">
                            {{#if Anexo_path_1}}
                            <div class="carousel-item active">
                                <img src="/img/141208_Megalitos/{{Anexo_path_1}}" class="d-block w-100" style="max-height: 600px; object-fit: contain; background-color: #333;" alt="Imagen 1">
                            </div>
                            {{/if}}
                            {{#if Anexo_path_2}}
                            <div class="carousel-item">
                                <img src="/img/141208_Megalitos/{{Anexo_path_2}}" class="d-block w-100" style="max-height: 600px; object-fit: contain; background-color: #333;" alt="Imagen 2">
                            </div>
                            {{/if}}
                            {{#if Anexo_path_3}}
                            <div class="carousel-item">
                                <img src="/img/141208_Megalitos/{{Anexo_path_3}}" class="d-block w-100" style="max-height: 600px; object-fit: contain; background-color: #333;" alt="Imagen 3">
                            </div>
                            {{/if}}
                            {{#if Anexo_path_4}}
                            <div class="carousel-item">
                                <img src="/img/141208_Megalitos/{{Anexo_path_4}}" class="d-block w-100" style="max-height: 600px; object-fit: contain; background-color: #333;" alt="Imagen 4">
                            </div>
                            {{/if}}
                            {{#if Anexo_path_5}}
                            <div class="carousel-item">
                                <img src="/img/141208_Megalitos/{{Anexo_path_5}}" class="d-block w-100" style="max-height: 600px; object-fit: contain; background-color: #333;" alt="Imagen 5">
                            </div>
                            {{/if}}
                            {{#if Anexo_path_6}}
                            <div class="carousel-item">
                                <img src="/img/141208_Megalitos/{{Anexo_path_6}}" class="d-block w-100" style="max-height: 600px; object-fit: contain; background-color: #333;" alt="Imagen 6">
                            </div>
                            {{/if}}
                             {{#if Anexo_path_7}}
                            <div class="carousel-item">
                                <img src="/img/141208_Megalitos/{{Anexo_path_7}}" class="d-block w-100" style="max-height: 600px; object-fit: contain; background-color: #333;" alt="Imagen 7">
                            </div>
                            {{/if}}
                             {{#if Anexo_path_8}}
                            <div class="carousel-item">
                                <img src="/img/141208_Megalitos/{{Anexo_path_8}}" class="d-block w-100" style="max-height: 600px; object-fit: contain; background-color: #333;" alt="Imagen 8">
                            </div>
                            {{/if}}
                            
                            {{#unless Anexo_path_1}}
                                <div class="text-center py-5">
                                    <p class="text-muted">No hay imágenes disponibles para este megalito.</p>
                                </div>
                            {{/unless}}
                        </div>
                        {{#if Anexo_path_1}}
                        <button class="carousel-control-prev" type="button" data-bs-target="#carouselMegalito" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Previous</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#carouselMegalito" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Next</span>
                        </button>
                        {{/if}}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{{/each}}