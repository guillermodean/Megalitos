<div class="container py-5">
  <div class="row">
    <div class="col-12">
      <div class="card shadow-sm">
        <div class="card-header bg-white">
          <h3 class="card-title text-primary mb-0">Listado de Megalitos</h3>
        </div>
        <div class="card-body">
          <div class="table-responsive">
            <table id="myTable" class="table table-striped table-hover w-100">
              <thead>
                <tr>
                  <th>Nombre</th>
                  <th>Tipo</th>
                  <th>Municipio</th>
                  <th>Fecha localizado</th>
                  <th>Autor</th>
                  <th>Ficha</th>
                </tr>
              </thead>
              <tbody>
                {{#each datos}}
                <tr>
                  <td>{{Nombre}}</td>
                  <td>{{Des_clas}}</td>
                  <td>{{Municipio}}</td>
                  <td>{{Localizado_fecha}}</td>
                  <td>{{Localizado_autor}}</td>
                  <td>
                    <a href="table/vista/{{Id}}" class="btn btn-sm btn-outline-primary">
                      <i class="fas fa-eye"></i> Ver
                    </a>
                  </td>
                </tr>
                {{else}}
                 {{! This block is often handled by datatables empty state, but keeping for fallback }}
                {{/each}}
              </tbody>
              <tfoot>
                <tr>
                  <th>Nombre</th>
                  <th>Tipo</th>
                  <th>Muncipio</th>
                  <th>Fecha localizado</th>
                  <th>Autor</th>
                  <th>Ficha</th>
                </tr>
              </tfoot>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  $(document).ready(function () {
    $('#myTable').DataTable({
      "pageLength": 50,
      "language": {
        "lengthMenu": "Mostrar _MENU_ registros",
        "zeroRecords": "No se encontraron resultados",
        "info": "Mostrando registros del _START_ al _END_ de un total de _TOTAL_ registros",
        "infoEmpty": "Mostrando registros del 0 al 0 de un total de 0 registros",
        "infoFiltered": "(filtrado de un total de _MAX_ registros)",
        "sSearch": "Buscar:",
        "oPaginate": {
          "sFirst": "Primero",
          "sLast": "Último",
          "sNext": "Siguiente",
          "sPrevious": "Anterior"
        },
        "sProcessing": "Procesando..."
      }
    });
  });
</script>